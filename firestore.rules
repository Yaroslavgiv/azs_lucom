rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function role() {
      return hasProfile() ? profile().role : 'specialist';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isManager() {
      return role() == 'manager' || isAdmin();
    }

    function isSpecialist() {
      return role() == 'specialist';
    }

    function notDisabled() {
      return !hasProfile() || profile().disabled != true;
    }

    function regionAllowed(region) {
      return isAdmin()
        || !hasProfile()
        || !(profile().keys().hasAny(['regions']))
        || region in profile().regions;
    }

    match /users/{userId} {
      allow read: if signedIn() && notDisabled();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /stations/{stationId} {
      allow read: if signedIn() && notDisabled();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /station_info/{stationId} {
      allow read: if signedIn() && notDisabled();
      allow write: if isManager() || isSpecialist();
    }

    match /station_equipment/{itemId} {
      allow read: if signedIn() && notDisabled();
      allow create, update: if signedIn() && notDisabled();
      allow delete: if isManager();
    }

    match /requests/{requestId} {
      allow read: if signedIn() && notDisabled();
      allow create: if signedIn() && notDisabled();
      allow update: if signedIn() && notDisabled() && (
        isManager()
        || resource.data.assignee_id == request.auth.uid
        || !('assignee_id' in resource.data)
      );
      allow delete: if false;
    }

    match /maintenance/{itemId} {
      allow read: if signedIn() && notDisabled();
      allow create: if signedIn() && notDisabled()
        && request.resource.data.status in ['planned', 'pending', 'in_review'];
      allow update: if signedIn() && notDisabled() && (
        isManager()
        || (
          request.resource.data.status in ['planned', 'in_review', 'returned']
          && request.resource.data.status != 'accepted'
        )
      );
      allow delete: if false;
    }

    match /defect_acts/{itemId} {
      allow read: if signedIn() && notDisabled();
      allow write: if signedIn() && notDisabled();
    }

    match /equipment_order_exports/{itemId} {
      allow read: if signedIn() && notDisabled();
      allow write: if signedIn() && notDisabled();
    }

    match /audit_log/{itemId} {
      allow read: if isManager();
      allow create: if signedIn() && notDisabled();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
